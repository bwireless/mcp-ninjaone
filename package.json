{
  "name": "mcp-ninjaone",
  "version": "1.1.0",
  "description": "MCP server for NinjaOne RMM — device management, monitoring, alerts, and automation",
  "type": "module",
  "bin": {
    "mcp-ninjaone": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bwireless/mcp-ninjaone.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ninjaone",
    "ninjarmm",
    "rmm",
    "claude"
  ]
}
